{
  "uid": "flowpay-operations",
  "title": "FlowPay — simulator operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "flowpay",
    "P8-T08"
  ],
  "links": [
    {
      "title": "Trace lookup (Tempo Explore)",
      "url": "/explore",
      "type": "link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "API mean latency (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "flowpay-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri,method) (rate(http_server_requests_seconds_sum{job=\"flowpay\",uri=~\"/api/v1/.*\"}[5m])) / sum by (uri,method) (rate(http_server_requests_seconds_count{job=\"flowpay\",uri=~\"/api/v1/.*\"}[5m]))",
          "legendFormat": "{{instance}} {{uri}} {{operation}} {{decision}} {{status}} {{queue}} {{outcome}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "API request rate / status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "flowpay-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"flowpay\",uri=~\"/api/v1/.*\"}[5m]))",
          "legendFormat": "{{instance}} {{uri}} {{operation}} {{decision}} {{status}} {{queue}} {{outcome}} {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Payment / refund provider p95 (fixed buckets)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "flowpay-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,outcome) (rate(flowpay_payment_provider_duration_seconds_bucket{job=\"flowpay\"}[5m])))",
          "legendFormat": "payment {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by (le,outcome) (rate(flowpay_refund_provider_duration_seconds_bucket{job=\"flowpay\"}[5m])))",
          "legendFormat": "refund {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
